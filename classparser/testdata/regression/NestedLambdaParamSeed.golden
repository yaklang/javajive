# Captured enclosing values use stable final aliases. The nested parameter must
# remain distinct from l0; TestNestedLambdaParamScopeIsLoadBearing additionally
# checks original bootstrap binding and the active OFF collision control.
+(l0) -> {
+(l2_0) -> {
+/final String \w+ = \w+;/
+/\(\w+\.equals\(l2_0\)\) && \(l2_0\.startsWith\(\w+\)\)/
+/return \w+\.test\(l0\);/
