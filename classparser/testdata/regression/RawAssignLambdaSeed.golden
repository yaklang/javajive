# Original instantiated Collection SAM remains typed when the target local is raw.
# TestRawAssignLambdaCastIsLoadBearing locks original BootstrapMethods and the
# carrier-to-assignment-to-return def-use, including both old switch settings.
+/Function<Collection, Collection> \w+ = Collections::unmodifiableCollection;/
+(Function<Collection, Collection>) ((l0) ->
+Collections.singleton(l0.iterator().next())
+/Function \w+ = this.builder;/
-/Function \w+ = Collections::unmodifiableCollection;/
