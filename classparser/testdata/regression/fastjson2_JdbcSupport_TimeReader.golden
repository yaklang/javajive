# Distinct slot live ranges have independent typed locals in their actual source
# scopes. A fresh reaching definition need not be hoisted or keep an old slot
# suffix. The formatter/read-string values must still feed the original parsers.
+/long \w+ = \w+\.readInt64Value\(\);/
+/DateTimeFormatter \w+ = this\.getDateFormatter\(\w+\.getLocale\(\)\);/
+/String \w+ = \w+\.readString\(\);/
+/LocalDateTime\.parse\(\(CharSequence\)\(\w+\),\w+\)/
+/DateUtils\.parseLocalTime\(\w+\.charAt\(0\),/
